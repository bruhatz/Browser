{
    "name": "Ubuntu Noble with Chrome GUI",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "containerEnv": {
        "DISPLAY": ":1.0"
    },
    "forwardPorts": [6080],
    "postAttachCommand": "start-desktop",
    "portsAttributes": {
        "6080": {
            "label": "Chrome desktop",
            "onAutoForward": "openBrowser",
            "visibility": "public"
        }
    }
}
